# Copy this file to .env.local for local development (or configure these as real
# environment variables in your hosting platform for production). .env.local is
# already git-ignored — never commit actual key values.

# --- LLM provider / model (all optional — see docs/PRODUCTION_READINESS.md) ---
# Declares the intended default provider. The model string itself still determines
# actual routing in pages/api/chat.js (a "gemini-" prefix routes to Gemini, anything
# else goes to OpenAI) — this only labels the default.
LLM_PROVIDER=openai

# Default model used when a request doesn't specify one (e.g. calling /api/chat
# directly rather than through the app's Settings dialog, which always sends its own
# selected model). Verify this model ID is actually live on your OpenAI account before
# setting it — the app does not validate model names, OpenAI's API does.
OPENAI_MODEL=gpt-4o-mini

# Server-side fallback API keys. The app's primary model is bring-your-own-key: users
# enter their own key in the Settings dialog, sent per-request, and that always takes
# priority over these. Set these only if you want a shared server-side key instead
# (e.g. a single-tenant internal deployment). Leave unset to keep pure BYOK behavior.
# NEVER commit a real value — this file only documents the variable name.
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Validation mode ---
# "retrieval-only" (default): runs the full pipeline (analysis, retrieval, prompt
#   construction) and returns a diagnostic event instead of calling the LLM. No API
#   key required, no API cost. Use this while building/validating the knowledge base.
# "full": makes real LLM calls. Requires a real API key (client-supplied or via
#   OPENAI_API_KEY/GEMINI_API_KEY above).
LLM_VALIDATION_MODE=retrieval-only

# --- Knowledge base indexing (optional overrides — sensible defaults exist) ---
# KNOWLEDGE_SOURCE_DIR=./knowledge
# KNOWLEDGE_INDEX_FILE=./data/knowledgeIndex.json
