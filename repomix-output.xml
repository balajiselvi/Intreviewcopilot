export function buildAnswerStyle(question = "", analysis = {}) {

    const q = question.toLowerCase();
// List / Which / Transaction Codes / Tables / Reports
if (
    /^which/i.test(question) ||
    /^list/i.test(question) ||
    /^name/i.test(question) ||
    q.includes("transaction code") ||
    q.includes("transaction codes") ||
    q.includes("t-code") ||
    q.includes("tcodes") ||
    q.includes("tables") ||
    q.includes("authorization objects") ||
    q.includes("reports")
) {

    return `
The interviewer is expecting an inventory-style answer.

Do NOT answer in paragraphs.

Instead:

1. Group related SAP objects into logical categories.

2. For each SAP object provide:
   • Name
   • Purpose (one concise sentence)

3. Highlight the transactions used most frequently in real SAP Security work.

4. Keep the answer concise.

5. Do NOT explain SAP history or business objectives.

6. End with one practical interview summary.
`;

}

    // What is...?
    if (
    /^what\s+is/i.test(question) ||
    /^explain/i.test(question)
) {

    return `
Output Format (MANDATORY)

Respond ONLY using categories.

Never answer in paragraphs.

Example format:

User Administration
• SU01 - Purpose
• SU10 - Purpose

Role Administration
• PFCG - Purpose
• SU24 - Purpose
• SU25 - Purpose

Troubleshooting
• SU53 - Purpose
• STAUTHTRACE - Purpose
• ST01 - Purpose

Security Audit
• SM19 - Purpose
• SM20 - Purpose
• SM18 - Purpose

Finish with one sentence stating which transactions are used most frequently.

If the answer is not in categories and bullet points, it is incorrect.
`;
    }

    // Difference
    if (
        q.includes("difference") ||
        q.includes("compare") ||
        q.includes("vs")
    ) {
        return `
Start with the core difference.

Then compare:
- Purpose
- Usage
- Configuration
- Example

Finish with one summary sentence.
`;
    }

    // Scenario / Troubleshooting
    if (
        q.includes("scenario") ||
        q.includes("issue") ||
        q.includes("error") ||
        q.includes("troubleshoot")
    ) {
        return `
Answer in this order:

Situation

↓

Analysis

↓

Root Cause

↓

Resolution

↓

Best Practice
`;
    }

    // Default
    return `
Answer naturally like a Senior SAP GRC Architect.

Do not sound like documentation.

Do not start with generic introductions.

Explain the execution flow first.

Mention only relevant SAP components.

Be concise and technically accurate.
`;
}
