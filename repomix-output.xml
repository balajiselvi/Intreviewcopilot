    "SM59 RFC GRC Connector"
  ],

  ruleset: [
    "SAP GRC Ruleset Function Risk Action Permission",
    "ARA Ruleset SoD Risk",
    "Ruleset Risk Analysis"
  ],

  arm: [
    "SAP GRC ARM Access Request Management MSMP BRF+ Provisioning"
  ],

  ara: [
    "SAP GRC ARA Risk Analysis Function Risk Permission"
  ],

  eam: [
    "SAP GRC EAM Firefighter Log Controller Owner"
  ],

  role: [
    "SAP Security PFCG Derived Role Composite Role SU24 SU25"
  ],

  troubleshooting: [
    "SU53 ST01 STAUTHTRACE SLG1 SM21 SM37"
  ]
};

export function expandQuery(question = "", analysis = {}) {
  const q = question.toLowerCase();
  const queries = [question];

  if (q.includes("connector"))
    queries.push(...SAP_PATTERNS.connector);

  if (q.includes("ruleset"))
    queries.push(...SAP_PATTERNS.ruleset);

  if (q.includes("arm"))
    queries.push(...SAP_PATTERNS.arm);

  if (q.includes("ara") || q.includes("risk"))
    queries.push(...SAP_PATTERNS.ara);

  if (q.includes("firefighter") || q.includes("eam"))
    queries.push(...SAP_PATTERNS.eam);

  if (
    q.includes("role") ||
    q.includes("authorization") ||
    q.includes("pfcg")
  )
    queries.push(...SAP_PATTERNS.role);

  if (
    analysis.intent === "troubleshooting" ||
    q.includes("error") ||
    q.includes("issue")
  )
    queries.push(...SAP_PATTERNS.troubleshooting);

  return [...new Set(queries)];
}
